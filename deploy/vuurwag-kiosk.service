# Vuurwag on the monitor plugged into the node: cage (Wayland kiosk) + foot on tty1, as the
# unprivileged user vuurwag. Installed and enabled by install.sh --monitor, only after a preflight
# (user, cage/foot/seatd, seatd active, ssh to root@127.0.0.1 working).
#
# The display user stays unprivileged; the read-only probe runs as root over ssh to 127.0.0.1 with a
# key that root's authorized_keys pins to from="127.0.0.1,::1",command="python3 -",restrict.
# PAMName=login opens a logind session, and pam_systemd sets XDG_RUNTIME_DIR (/run/user/<uid>) for it.
# (No /run/user/%U here: in a system unit %U is the service manager's uid, 0, not User=.)
#
# tty1 safety: getty@tty1 stays enabled. At boot the kiosk wins through Conflicts=; if the kiosk gives
# up (5 failed starts in 120 s) OnFailure= starts getty@tty1 again, so tty1 never stays dead.
# If you stop the kiosk by hand: systemctl start getty@tty1
#
# Config: /etc/vuurwag/vuurwag.env and ~vuurwag/.config/foot/foot.ini   Logs: journalctl -u vuurwag-kiosk

[Unit]
Description=Vuurwag - a braai in ASCII on the monitor (cage + foot on tty1)
Documentation=https://github.com/RuanBuitendag42/vuurwag
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service seatd.service pve-cluster.service getty@tty1.service
Wants=seatd.service
Conflicts=getty@tty1.service
OnFailure=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=vuurwag
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=/etc/vuurwag/vuurwag.env
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=PYTHONSAFEPATH=1
WorkingDirectory=~
ExecStart=/usr/bin/cage -- /usr/bin/foot -e /opt/vuurwag/.venv/bin/vuurwag --ssh root@127.0.0.1 --fps ${VUURWAG_FPS}
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
