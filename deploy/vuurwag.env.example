# /etc/vuurwag/vuurwag.env - read by vuurwag-web and vuurwag-kiosk (systemd EnvironmentFile).
# install.sh writes it once (from its flags and the node's primary interface) and afterwards only
# changes the keys you pass as flags. Edit, then: systemctl restart vuurwag-web vuurwag-kiosk

# Town for the weather (Open-Meteo, no key). Most specific part first; it falls back part by part.
# Empty or absent = the default in vuurwag/weather.py (DEFAULT_PLACE). Same as --place.
VUURWAG_PLACE="Your Town, South Africa"
# Port of the web page for the TV (vuurwag-web). Same as --port.
VUURWAG_PORT="8787"
# The LAN allowed to that port through pve-firewall (the installer's host rule). Same as --lan.
VUURWAG_LAN="192.0.2.0/24"
# The URL the TV's browser uses; textual-serve builds the websocket URL from it. Same as --public-url.
VUURWAG_PUBLIC_URL="http://192.0.2.10:8787"
# Frames a second, 1-20. 4 is plenty for a slow TV browser. Same as --fps.
VUURWAG_FPS="10"
