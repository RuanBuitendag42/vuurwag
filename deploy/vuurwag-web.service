# Vuurwag served to a browser (the TV) with textual-serve. Installed by install.sh --tv.
#
# Runs as root because the probe needs pvesh/pct/pvesm/smartctl; it probes LOCALLY (no ssh at all: the
# app finds pvesh on the node itself). textual-serve starts one app process per browser tab and hands it
# this service's environment, so VUURWAG_PLACE reaches the weather from here.
# The page has no authentication: it listens on VUURWAG_BIND (default 0.0.0.0, every network the node is
# on, Tailscale included; install.sh --bind IP narrows it) and install.sh adds a pve-firewall rule for
# VUURWAG_LAN when the firewall is enabled. VUURWAG_PUBLIC_URL must be the address the TV uses: textual-serve builds the page's
# websocket URL from it.
# Each tab is 'python -P -m vuurwag': -P and PYTHONSAFEPATH keep the cwd off sys.path, and the cwd is the
# empty /var/lib/vuurwag, so nothing left in /opt/vuurwag by an older install can shadow the venv's package.
#
# Config: /etc/vuurwag/vuurwag.env   Logs: journalctl -u vuurwag-web

[Unit]
Description=Vuurwag - a braai in ASCII for this Proxmox node (web page for the TV)
Documentation=https://github.com/RuanBuitendag42/vuurwag
After=network-online.target pve-cluster.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
EnvironmentFile=/etc/vuurwag/vuurwag.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONSAFEPATH=1
StateDirectory=vuurwag
WorkingDirectory=/var/lib/vuurwag
ExecStart=/opt/vuurwag/.venv/bin/vuurwag serve --host ${VUURWAG_BIND} --port ${VUURWAG_PORT} --public-url ${VUURWAG_PUBLIC_URL} -- --fps ${VUURWAG_FPS}
Restart=on-failure
RestartSec=5
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
